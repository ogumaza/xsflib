# SPDX-License-Identifier: MIT

# find_package(xsflib) reads this file. It finds the libraries that xsflib was built with, then its targets.

@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(XSFLIB_PSF @XSFLIB_PSF@)
set(XSFLIB_CLI @XSFLIB_CLI@)
set(XSFLIB_DISC_LIBRARIES @XSFLIB_DISC_LIBRARIES@)
set(XSFLIB_ZSTD @XSFLIB_ZSTD@)

find_dependency(Threads)
if (XSFLIB_PSF OR XSFLIB_DISC_LIBRARIES)
    find_dependency(ZLIB)
endif()
if (XSFLIB_DISC_LIBRARIES OR XSFLIB_ZSTD)
    find_dependency(zstd CONFIG)
endif()
if (XSFLIB_DISC_LIBRARIES)
    find_dependency(LibLZMA)
    find_dependency(BZip2)
endif()
if (XSFLIB_CLI)
    if (@XSFLIB_FLAC_FROM_PKG_CONFIG@)
        find_dependency(PkgConfig)
        pkg_check_modules(XSFLIB_FLAC REQUIRED IMPORTED_TARGET flac)
    else()
        find_dependency(FLAC CONFIG)
    endif()
endif()
find_dependency(seqlib 1.0)

include(${CMAKE_CURRENT_LIST_DIR}/xsflibTargets.cmake)
check_required_components(xsflib)
